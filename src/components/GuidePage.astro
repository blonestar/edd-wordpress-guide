---
import {
  commandConfig,
  lighthouseExample,
  officialLinks,
  playwrightExample,
  promptfooExample,
  repoLayout,
} from "../content/shared";
import type { GuideCopy } from "../content/types";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  copy: GuideCopy;
  locales: readonly GuideCopy[];
}

const { copy, locales } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const localeLinks = locales.map((locale) => ({
  code: locale.locale,
  htmlLang: locale.htmlLang,
  name: locale.languageName,
  shortName: locale.shortLanguageName,
  href: locale.locale === "en" ? base : `${base}${locale.locale}/`,
  current: locale.locale === copy.locale,
}));
---

<BaseLayout copy={copy} localeLinks={localeLinks}>
  <a class="skip-link" href="#content">{copy.skipLink}</a>

  <header class="site-header">
    <a class="brand" href="#top" aria-label={copy.brand.homeLabel}>
      <span class="brand-mark" aria-hidden="true">E</span>
      <span>
        <strong>{copy.brand.name}</strong>
        <small>{copy.brand.subtitle}</small>
      </span>
    </a>

    <nav aria-label={copy.nav.label}>
      <a href="#basics">{copy.nav.basics}</a>
      <a href="#tools">{copy.nav.tools}</a>
      <a href="#architecture">{copy.nav.architecture}</a>
      <a href="#start">{copy.nav.start}</a>
    </nav>

    <div class="header-actions">
      <details class="language-menu">
        <summary aria-label={copy.languageMenu.label}>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3.5 9h17M3.5 15h17M12 3c2.2 2.5 3.3 5.5 3.3 9S14.2 18.5 12 21M12 3C9.8 5.5 8.7 8.5 8.7 12S9.8 18.5 12 21"></path>
          </svg>
          <span>{copy.shortLanguageName}</span>
          <svg
            class="language-chevron"
            aria-hidden="true"
            viewBox="0 0 16 16"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="m3 6 5 5 5-5"></path>
          </svg>
        </summary>
        <ul aria-label={copy.languageMenu.label}>
          {
            localeLinks.map((locale) => (
              <li>
                <a
                  href={locale.href}
                  lang={locale.htmlLang}
                  aria-current={locale.current ? "page" : undefined}
                >
                  <span>{locale.name}</span>
                  {locale.current && <span aria-hidden="true">✓</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <a class="header-cta" href="#checklist">{copy.nav.checklist}</a>
    </div>
  </header>

  <main id="content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span aria-hidden="true">●</span> {copy.hero.eyebrow}
        </p>
        <h1 id="hero-title">
          {copy.hero.titleLine1}
          <br />
          <span>{copy.hero.titleLine2}</span>
        </h1>
        <p class="hero-lede">{copy.hero.lede}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#architecture">
            {copy.hero.primaryCta}
          </a>
          <a class="button button-secondary" href="#examples">
            {copy.hero.secondaryCta}
          </a>
        </div>
        <div class="hero-note">
          <span class="note-icon" aria-hidden="true">✓</span>
          <p>
            {copy.hero.notePrefix} <strong>{copy.hero.noteStrong}</strong>
            {copy.hero.noteSuffix}
          </p>
        </div>
      </div>

      <div class="hero-visual" aria-label={copy.hero.visualLabel}>
        <div class="visual-orbit visual-orbit-one" aria-hidden="true"></div>
        <div class="visual-orbit visual-orbit-two" aria-hidden="true"></div>
        {
          copy.hero.flowCards.map((card, index) => (
            <div
              class:list={[
                "flow-card",
                index === 0 && "flow-card-task",
                index === 1 && "flow-card-agent",
                index === 2 && "flow-card-evals",
                index === 3 && "flow-card-proof",
              ]}
            >
              <span>{card.number}</span>
              <strong>{card.title}</strong>
              <small>{card.text}</small>
            </div>
          ))
        }
        <div class="visual-core">
          <span>{copy.hero.core}</span>
          <strong>
            {
              copy.hero.coreText.split("\n").map((line, index, lines) => (
                <>
                  {line}
                  {index < lines.length - 1 && <br />}
                </>
              ))
            }
          </strong>
        </div>
        <div class="visual-caption">{copy.hero.caption}</div>
      </div>
    </section>

    <section class="signal-strip" aria-label={copy.signals.label}>
      {
        copy.signals.items.map((item) => (
          <p>
            <strong>{item.title}</strong>
            <span>{item.text}</span>
          </p>
        ))
      }
    </section>

    <section class="section" id="basics" aria-labelledby="basics-title">
      <div class="section-heading">
        <p class="section-kicker">{copy.basics.kicker}</p>
        <h2 id="basics-title">{copy.basics.title}</h2>
        <p>{copy.basics.intro}</p>
      </div>

      <div class="definition-grid">
        {
          copy.basics.cards.map((card) => (
            <article class="definition-card">
              <span class="definition-number">{card.letter}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))
        }
      </div>

      <div class="edd-loop" role="img" aria-label={copy.basics.loopLabel}>
        {
          copy.basics.loop.map((step, index) => (
            <>
              <div>
                <span>{step.number}</span>
                <strong>{step.text}</strong>
              </div>
              {index < copy.basics.loop.length - 1 && (
                <i aria-hidden="true">{index === 3 ? "↺" : "→"}</i>
              )}
            </>
          ))
        }
      </div>
    </section>

    <section class="section section-tinted" aria-labelledby="grader-title">
      <div class="section-heading compact">
        <p class="section-kicker">{copy.graders.kicker}</p>
        <h2 id="grader-title">{copy.graders.title}</h2>
        <p>{copy.graders.intro}</p>
      </div>

      <div class="grader-grid">
        <article class="grader-card deterministic">
          <div class="grader-head">
            <span class="grader-icon" aria-hidden="true">01</span>
            <div>
              <p>{copy.graders.deterministic.overline}</p>
              <h3>{copy.graders.deterministic.title}</h3>
            </div>
          </div>
          <p>{copy.graders.deterministic.text}</p>
          <ul
            class="tag-list"
            aria-label={copy.graders.deterministic.tagsLabel}
          >
            {copy.graders.deterministic.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <div class="grader-example">
            <span>{copy.graders.deterministic.exampleLabel}</span>
            <code>{copy.graders.deterministic.example}</code>
          </div>
        </article>

        <article class="grader-card model">
          <div class="grader-head">
            <span class="grader-icon" aria-hidden="true">02</span>
            <div>
              <p>{copy.graders.model.overline}</p>
              <h3>{copy.graders.model.title}</h3>
            </div>
          </div>
          <p>{copy.graders.model.text}</p>
          <ul class="tag-list" aria-label={copy.graders.model.tagsLabel}>
            {copy.graders.model.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <div class="grader-example">
            <span>{copy.graders.model.exampleLabel}</span>
            <code>{copy.graders.model.example}</code>
          </div>
        </article>
      </div>

      <div class="decision-ladder" aria-label={copy.graders.ladderLabel}>
        {
          copy.graders.ladder.map((step, index) => (
            <>
              <span>{step}</span>
              {index < copy.graders.ladder.length - 1 && (
                <i aria-hidden="true">→</i>
              )}
            </>
          ))
        }
      </div>
    </section>

    <section class="section" id="tools" aria-labelledby="tools-title">
      <div class="section-heading">
        <p class="section-kicker">{copy.tools.kicker}</p>
        <h2 id="tools-title">{copy.tools.title}</h2>
        <p>{copy.tools.intro}</p>
      </div>

      <div class="tool-grid">
        {
          copy.tools.items.map((tool) => (
            <article class="tool-card">
              <div class:list={["tool-mark", tool.tone]} aria-hidden="true">
                {tool.mark}
              </div>
              <h3>{tool.name}</h3>
              <p>{tool.use}</p>
              <div class="tool-boundary">
                <strong>{copy.tools.boundaryLabel}</strong>
                <span>{tool.notFor}</span>
              </div>
              <a
                href={tool.link}
                class="text-link"
                target="_blank"
                rel="noreferrer noopener"
              >
                {tool.linkLabel}<span aria-hidden="true"> ↗</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="section section-dark"
      id="architecture"
      aria-labelledby="architecture-title"
    >
      <div class="section-heading inverse">
        <p class="section-kicker">{copy.architecture.kicker}</p>
        <h2 id="architecture-title">{copy.architecture.title}</h2>
        <p>{copy.architecture.intro}</p>
      </div>

      <div class="architecture-diagram">
        <div class="architecture-column local">
          <div class="architecture-title">
            <span>{copy.architecture.local.badge}</span>
            <h3>{copy.architecture.local.title}</h3>
            <p>{copy.architecture.local.intro}</p>
          </div>
          <div class="architecture-stack">
            {
              copy.architecture.local.items.map((item) => (
                <div>
                  <span>{item.number}</span>
                  <strong>{item.title}</strong>
                  <small>{item.text}</small>
                </div>
              ))
            }
          </div>
        </div>

        <div class="architecture-bridge" aria-hidden="true">
          <span>{copy.architecture.bridge[0]}</span>
          <i>⇄</i>
          <span>{copy.architecture.bridge[1]}</span>
        </div>

        <div class="architecture-column central">
          <div class="architecture-title">
            <span>{copy.architecture.central.badge}</span>
            <h3>{copy.architecture.central.title}</h3>
            <p>{copy.architecture.central.intro}</p>
          </div>
          <div class="architecture-stack">
            {
              copy.architecture.central.items.map((item) => (
                <div>
                  <span>{item.number}</span>
                  <strong>{item.title}</strong>
                  <small>{item.text}</small>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="architecture-rule">
        <span aria-hidden="true">!</span>
        <p>
          <strong>{copy.architecture.ruleLabel}</strong> {copy.architecture.rule}
        </p>
      </div>
    </section>

    <section
      class="section"
      id="promptfoo"
      aria-labelledby="promptfoo-title"
    >
      <div class="split-heading">
        <div>
          <p class="section-kicker">{copy.promptfoo.kicker}</p>
          <h2 id="promptfoo-title">{copy.promptfoo.title}</h2>
        </div>
        <p>{copy.promptfoo.intro}</p>
      </div>

      <div class="promptfoo-flow" role="img" aria-label={copy.promptfoo.flowLabel}>
        <div class="promptfoo-inputs">
          {copy.promptfoo.inputs.map((item) => <span>{item}</span>)}
        </div>
        <i aria-hidden="true">→</i>
        <div class="promptfoo-core">
          <small>{copy.promptfoo.coreOverline}</small>
          <strong>Promptfoo</strong>
          <span>{copy.promptfoo.coreText}</span>
        </div>
        <i aria-hidden="true">→</i>
        <div class="promptfoo-graders">
          {copy.promptfoo.graders.map((item) => <span>{item}</span>)}
        </div>
        <i aria-hidden="true">→</i>
        <div class="promptfoo-result">
          <small>{copy.promptfoo.resultOverline}</small>
          <strong>{copy.promptfoo.resultTitle}</strong>
          <span>{copy.promptfoo.resultText}</span>
        </div>
      </div>

      <div class="when-grid">
        <article class="when-card yes">
          <span class="when-label">{copy.promptfoo.yesLabel}</span>
          <ul>{copy.promptfoo.yes.map((item) => <li>{item}</li>)}</ul>
        </article>
        <article class="when-card no">
          <span class="when-label">{copy.promptfoo.noLabel}</span>
          <ul>{copy.promptfoo.no.map((item) => <li>{item}</li>)}</ul>
        </article>
      </div>

      <aside class="caution-card">
        <span aria-hidden="true">{copy.promptfoo.cautionLabel}</span>
        <p>
          {copy.promptfoo.cautionBefore}{" "}
          <strong>{copy.promptfoo.cautionStrong}</strong>
          {copy.promptfoo.cautionAfter}
        </p>
        <a
          href={officialLinks.promptfooAgents}
          class="text-link"
          target="_blank"
          rel="noreferrer noopener"
        >
          {copy.promptfoo.cautionLink}<span aria-hidden="true"> ↗</span>
        </a>
      </aside>
    </section>

    <section class="section section-tinted" id="mcp" aria-labelledby="mcp-title">
      <div class="section-heading">
        <p class="section-kicker">{copy.mcp.kicker}</p>
        <h2 id="mcp-title">{copy.mcp.title}</h2>
        <p>{copy.mcp.intro}</p>
      </div>

      <div class="mcp-grid">
        <article>
          <div class="mcp-card-head good">
            <span aria-hidden="true">+</span>
            <h3>{copy.mcp.yesTitle}</h3>
          </div>
          <ul>{copy.mcp.yes.map((item) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <div class="mcp-card-head bad">
            <span aria-hidden="true">−</span>
            <h3>{copy.mcp.noTitle}</h3>
          </div>
          <ul>{copy.mcp.no.map((item) => <li>{item}</li>)}</ul>
        </article>
      </div>
      <p class="source-note">
        {copy.mcp.sourcePrefix}{" "}
        <a
          href={officialLinks.mcp}
          target="_blank"
          rel="noreferrer noopener"
        >
          {copy.mcp.sourceLink}<span aria-hidden="true"> ↗</span>
        </a>.
      </p>
    </section>

    <section class="section" id="examples" aria-labelledby="repo-title">
      <div class="split-heading">
        <div>
          <p class="section-kicker">{copy.setup.kicker}</p>
          <h2 id="repo-title">{copy.setup.title}</h2>
        </div>
        <p>{copy.setup.intro}</p>
      </div>

      <div class="code-layout">
        <article class="code-panel repo-panel">
          <div class="code-panel-head">
            <span>{copy.setup.repoPanelTitle}</span>
            <small>{copy.setup.repoPanelMeta}</small>
          </div>
          <pre aria-label={copy.setup.repoAria}><code>{repoLayout}</code></pre>
        </article>

        <article class="code-panel command-panel">
          <div class="code-panel-head">
            <span>{copy.setup.commandPanelTitle}</span>
            <small>{copy.setup.commandPanelMeta}</small>
          </div>
          <pre aria-label={copy.setup.commandAria}><code>{commandConfig}</code></pre>
          <div class="code-callout">
            {copy.setup.commandCalloutBefore} <code>eval:fast</code>
            {copy.setup.commandCalloutMiddle} <code>eval:full</code>
            {copy.setup.commandCalloutAfter}
          </div>
        </article>
      </div>

      <div class="example-tabs" aria-label={copy.setup.examplesLabel}>
        <details open>
          <summary>
            <span>{copy.setup.examples.playwrightTitle}</span>
            <small>{copy.setup.examples.deterministic}</small>
          </summary>
          <pre><code>{playwrightExample}</code></pre>
          <p>{copy.setup.examples.playwrightNote}</p>
        </details>

        <details>
          <summary>
            <span>{copy.setup.examples.lighthouseTitle}</span>
            <small>{copy.setup.examples.labSignal}</small>
          </summary>
          <pre><code>{lighthouseExample}</code></pre>
          <p>{copy.setup.examples.lighthouseNote}</p>
        </details>

        <details>
          <summary>
            <span>{copy.setup.examples.promptfooTitle}</span>
            <small>{copy.setup.examples.later}</small>
          </summary>
          <pre><code>{promptfooExample}</code></pre>
          <p>{copy.setup.examples.promptfooNote}</p>
        </details>
      </div>
    </section>

    <section
      class="section section-tinted"
      id="start"
      aria-labelledby="start-title"
    >
      <div class="section-heading">
        <p class="section-kicker">{copy.phases.kicker}</p>
        <h2 id="start-title">{copy.phases.title}</h2>
        <p>{copy.phases.intro}</p>
      </div>

      <ol class="phase-list">
        {
          copy.phases.items.map((phase) => (
            <li>
              <span class="phase-number">{phase.number}</span>
              <div>
                <h3>{phase.title}</h3>
                <p>{phase.text}</p>
              </div>
              <code>{phase.deliverable}</code>
            </li>
          ))
        }
      </ol>

      <div class="stop-rule">
        <span aria-hidden="true">◆</span>
        <p>
          <strong>{copy.phases.thresholdLabel}</strong> {copy.phases.threshold}
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="pitfalls-title">
      <div class="section-heading compact">
        <p class="section-kicker">{copy.pitfalls.kicker}</p>
        <h2 id="pitfalls-title">{copy.pitfalls.title}</h2>
      </div>
      <div class="pitfall-grid">
        {
          copy.pitfalls.items.map((pitfall, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{pitfall.title}</h3>
              <p>{pitfall.fix}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="section checklist-section"
      id="checklist"
      aria-labelledby="checklist-title"
    >
      <div class="checklist-intro">
        <p class="section-kicker">{copy.checklist.kicker}</p>
        <h2 id="checklist-title">{copy.checklist.title}</h2>
        <p>{copy.checklist.intro}</p>
        <a class="button button-light" href="#resources">
          {copy.checklist.resourcesCta}
        </a>
      </div>

      <div class="checklist-card">
        {
          copy.checklist.items.map((item, index) => (
            <label>
              <input type="checkbox" />
              <span class="custom-checkbox" aria-hidden="true"></span>
              <span>
                <small>{String(index + 1).padStart(2, "0")}</small>
                {item}
              </span>
            </label>
          ))
        }
      </div>
    </section>

    <section
      class="section resources-section"
      id="resources"
      aria-labelledby="resources-title"
    >
      <div class="section-heading compact">
        <p class="section-kicker">{copy.resources.kicker}</p>
        <h2 id="resources-title">{copy.resources.title}</h2>
        <p>{copy.resources.intro}</p>
      </div>

      <div class="resource-grid">
        {
          copy.resources.groups.map((group) => (
            <article>
              <h3>{group.group}</h3>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {link.label}<span aria-hidden="true"> ↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="final-recommendation">
        <span class="final-mark" aria-hidden="true">E</span>
        <div>
          <p class="section-kicker">{copy.final.kicker}</p>
          <h2>{copy.final.title}</h2>
          <p>{copy.final.text}</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div>
      <strong>{copy.footer.title}</strong>
      <p>{copy.footer.text}</p>
    </div>
    <p>
      {copy.footer.verified} · <a href="#top">{copy.footer.backToTop}</a>
    </p>
  </footer>
</BaseLayout>
