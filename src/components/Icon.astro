---
interface Props {
  name:
    | "alert"
    | "arrow-right"
    | "check"
    | "external"
    | "minus"
    | "plus"
    | "refresh";
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Props["name"], string[]> = {
  alert: ["M12 9v4", "M12 17h.01", "M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z"],
  "arrow-right": ["M5 12h14", "m14 7 5 5-5 5"],
  check: ["m5 12 4 4L19 6"],
  external: ["M14 5h5v5", "M10 14 19 5", "M19 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"],
  minus: ["M5 12h14"],
  plus: ["M12 5v14", "M5 12h14"],
  refresh: ["M20 7v5h-5", "M4 17v-5h5", "M6.1 9a7 7 0 0 1 11.5-2.6L20 12", "M4 12l2.4 5.6A7 7 0 0 0 17.9 15"],
};
---

<svg
  class:list={["icon", className]}
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
>
  {paths[name].map((path) => <path d={path}></path>)}
</svg>
